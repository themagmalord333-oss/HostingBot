name: Auto Restart Runner

on:
  workflow_run:
    workflows:
      - "Ultimate Deployer & Runner"
    types:
      - completed

permissions:
  actions: write
  contents: read

concurrency:
  group: hosted-bot-auto-restart
  cancel-in-progress: false

jobs:
  restart-bot:
    runs-on: ubuntu-latest

    steps:

      # ============================================================
      # COOLDOWN
      # ============================================================
      - name: Wait for Previous Runner
        shell: bash
        run: |
          echo "Previous bot runner completed."
          echo "Waiting 30 seconds..."
          sleep 30

      # ============================================================
      # START NEXT RUN
      # ============================================================
      - name: Trigger Next Bot Run
        env:
          GH_TOKEN: ${{ secrets.GH_PERSONAL_TOKEN }}
          REPOSITORY: ${{ github.repository }}
          EVENT_TYPE: run-hosted-bot
        shell: bash
        run: |
          set -Eeuo pipefail

          if [ -z "${GH_TOKEN:-}" ]; then
            echo "ERROR: GH_PERSONAL_TOKEN secret is missing."
            exit 1
          fi

          echo "Starting next hosted bot run..."

          HTTP_CODE=$(
            curl \
              -sS \
              -o response.json \
              -w "%{http_code}" \
              -X POST \
              "https://api.github.com/repos/${REPOSITORY}/dispatches" \
              -H "Accept: application/vnd.github+json" \
              -H "Authorization: Bearer ${GH_TOKEN}" \
              -H "X-GitHub-Api-Version: 2022-11-28" \
              -H "Content-Type: application/json" \
              -d "{\"event_type\":\"${EVENT_TYPE}\"}"
          )

          echo "GitHub API HTTP status: $HTTP_CODE"

          if [ "$HTTP_CODE" != "204" ]; then
            echo "ERROR: repository_dispatch failed."

            echo "Response:"
            cat response.json || true

            exit 1
          fi

          echo "=========================================="
          echo "NEXT BOT RUN TRIGGERED SUCCESSFULLY"
          echo "=========================================="